-- Game (Huss Valley: one Chaser, runners cross the map, caught = Chaser)
local G = {chaserEsp = false, alert = false, flee = false, fleeDist = 30, antiVoid = false, finish = nil, lastSafe = nil}

local function isChaser(p)
	local c = p.Character
	if p.Team and p.Team.Name:lower():find("chas") then return true end
	for _, n in ipairs({"Chaser", "IsChaser", "chaser", "isChaser", "Role", "Seeker", "It", "Tagged"}) do
		local a = p:GetAttribute(n)
		if a == nil and c then a = c:GetAttribute(n) end
		if a == true or (type(a) == "string" and a:lower():find("chas")) then return true end
	end
	if c then
		for _, t in ipairs(c:GetChildren()) do
			if t:IsA("Tool") and t.Name:lower():find("knife") then return true end
		end
		local bp = p:FindFirstChildOfClass("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find("knife") then return true end
			end
		end
	end
	return false
end

local function nearestChaser()
	local r = root()
	if not r then return nil, math.huge end
	local best, bd = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and isChaser(p) then
			local d = (p.Character.HumanoidRootPart.Position - r.Position).Magnitude
			if d < bd then best, bd = p, d end
		end
	end
	return best, bd
end

