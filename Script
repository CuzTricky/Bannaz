RunService.RenderStepped:Connect(function()
	-- spectate
	if X.spectate then
		local cp = nearestChaser()
		if cp and cp.Character and cp.Character:FindFirstChildOfClass("Humanoid") then
			Camera.CameraSubject = cp.Character:FindFirstChildOfClass("Humanoid")
		end
	end
	-- tracer
	if tracerLine then
		local cp = X.tracer and nearestChaser()
		if cp and cp.Character and cp.Character:FindFirstChild("HumanoidRootPart") then
			local pos, vis = Camera:WorldToViewportPoint(cp.Character.HumanoidRootPart.Position)
			tracerLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
			tracerLine.To = Vector2.new(pos.X, pos.Y)
			tracerLine.Visible = vis
		else
			tracerLine.Visible = false
		end
	end
end)

RunService.Heartbeat:Connect(function()
	local h, r = hum(), root()
	if not h or not r then return end
	if X.antiRagdoll then
		pcall(function()
			h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
			h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		end)
		local st = h:GetState()
		if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		if not S.fly then h.PlatformStand = false end
	end
	if X.bhop and h.FloorMaterial ~= Enum.Material.Air and h.MoveDirection.Magnitude > 0 then
		h.Jump = true
	end
	if X.airWalk then
		if not airPart then
			airPart = new("Part", {Size = Vector3.new(10, 1, 10), Anchored = true, Transparency = 1, CanCollide = true, Name = "HVAir", Parent = workspace})
		end
		-- floor stays at the height you were on; hold Ctrl (or toggle off/on) to re-level it to you
		local y = airPart:GetAttribute("Y") or (r.Position.Y - 3.5)
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then y = r.Position.Y - 3.5 end
		airPart:SetAttribute("Y", y)
		airPart.Position = Vector3.new(r.Position.X, y, r.Position.Z)
	end
end)

