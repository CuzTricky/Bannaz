--// COMPONENTS
local function Toggle(page, text, default, cb)
	local state = default
	local row = new("TextButton", {Text = "", Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = C.item, AutoButtonColor = false, Parent = page}, {corner(8)})
	new("TextLabel", {Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = row})
	local track = new("Frame", {Size = UDim2.fromOffset(38, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = state and C.accent or C.off, Parent = row}, {corner(10)})
	local knob = new("Frame", {Size = UDim2.fromOffset(14, 14), Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1), Parent = track}, {corner(7)})
	local function set(v)
		state = v
		tween(track, {BackgroundColor3 = v and C.accent or C.off}, 0.2)
		tween(knob, {Position = v and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)}, 0.2, Enum.EasingStyle.Back)
		cb(v)
	end
	row.MouseButton1Click:Connect(function() set(not state) end)
	row.MouseEnter:Connect(function() tween(row, {BackgroundColor3 = C.hover}, 0.15) end)
	row.MouseLeave:Connect(function() tween(row, {BackgroundColor3 = C.item}, 0.15) end)
	if default then cb(true) end
	return set
end

local function Slider(page, text, min, max, default, cb)
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = C.item, Parent = page}, {corner(8)})
	local label = new("TextLabel", {Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.7, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, Parent = row})
	local val = new("TextLabel", {Text = tostring(default), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.accent, BackgroundTransparency = 1,
		Position = UDim2.new(0.7, 0, 0, 6), Size = UDim2.new(0.3, -12, 0, 18), TextXAlignment = Enum.TextXAlignment.Right, Parent = row})
	local bar = new("Frame", {Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 34), BackgroundColor3 = C.off, Parent = row}, {corner(3)})
	local fill = new("Frame", {Size = UDim2.fromScale((default - min) / (max - min), 1), BackgroundColor3 = C.accent, Parent = bar}, {corner(3)})
	local dragging = false
	local function update(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * rel)
		tween(fill, {Size = UDim2.fromScale(rel, 1)}, 0.08)
		val.Text = tostring(v)
		cb(v)
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; update(i.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i.Position.X) end
	end)
end

local function Button(page, text, cb)
	local b = new("TextButton", {Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, BackgroundColor3 = C.item,
		Size = UDim2.new(1, 0, 0, 36), AutoButtonColor = false, Parent = page}, {corner(8)})
