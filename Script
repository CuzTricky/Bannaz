local gameESP = {}
local function setGameESP(p, chaser)
	local c = p.Character
	if not c then return end
	local hl = gameESP[p]
	if not hl or hl.Parent ~= c then
		if hl then hl:Destroy() end
		hl = new("Highlight", {FillTransparency = 0.45, OutlineColor = Color3.new(1, 1, 1), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = c})
		gameESP[p] = hl
	end
	hl.FillColor = chaser and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(60, 255, 120)
end

task.spawn(function()
	local lastFlee = 0
	while Gui.Parent do
		task.wait(0.15)
		-- ESP
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				if G.chaserEsp then
					setGameESP(p, isChaser(p))
				elseif gameESP[p] then
					gameESP[p]:Destroy(); gameESP[p] = nil
				end
			end
		end
		-- status
		local cp, d = nearestChaser()
		if cp then
			statusLabel.Text = ("Nearest chaser: %s (%d studs)"):format(cp.DisplayName, d)
			tween(statusLabel, {TextColor3 = d < 40 and Color3.fromRGB(255, 80, 80) or C.accent}, 0.2)
			if G.alert and d < 40 then
				tween(Main, {BackgroundColor3 = Color3.fromRGB(45, 15, 15)}, 0.15)
				task.delay(0.2, function() tween(Main, {BackgroundColor3 = C.bg}, 0.3) end)
			end
			-- auto flee
			local r = root()
			if G.flee and r and d < G.fleeDist and tick() - lastFlee > 1 and cp.Character then
				lastFlee = tick()
				if G.finish then
					r.CFrame = G.finish + Vector3.new(0, 3, 0)
				else
					local away = (r.Position - cp.Character.HumanoidRootPart.Position) * Vector3.new(1, 0, 1)
					if away.Magnitude > 0 then r.CFrame = r.CFrame + away.Unit * 45 + Vector3.new(0, 2, 0) end
				end
			end
		else
			statusLabel.Text = "Nearest chaser: none found"
		end
		-- anti void
		local h, r = hum(), root()
		if h and r then
			if h.FloorMaterial ~= Enum.Material.Air and r.Position.Y > -50 then
				G.lastSafe = r.CFrame
			elseif G.antiVoid and G.lastSafe and r.Position.Y < G.lastSafe.Position.Y - 60 then
				r.AssemblyLinearVelocity = Vector3.zero
				r.CFrame = G.lastSafe + Vector3.new(0, 4, 0)
			end
		end
	end
end)

